# Server-side configuration template for Drug SMS Checker AI/ML.
# Copy to .env on the SERVER ONLY, or supply these variables through the backend's
# secure environment-variable / secrets-management mechanism. Host environment
# variables win over .env (python-dotenv is loaded with override=False).
# NEVER place a real key in this file, in source control, in logs, or in the ZIP.

# Required only for live Gemini operations (explanations, intent extraction, image extraction).
# Placeholder below - replace with a key supplied through your secure secret store.
GEMINI_API_KEY=REPLACE_WITH_BACKEND_MANAGED_KEY

# Optional model override. Leave empty to use the existing default: gemini-3.1-flash-lite.
GEMINI_MODEL=

# Set to 1 only to force deterministic mocked responses even when a key exists.
# Keep at 0 for normal live operation when a valid key is configured.
AI_ML_MOCK=0
